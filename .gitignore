!.env.example

# 系统杂项
.DS_Store
Thumbs.db
*.log
.trash/

# 测试套件的 npx tsx 实跑临时脚本(跑完即删;进程占用/EPERM 时会残留成 untracked 垃圾)
relaylens/probe/.tmp-*
relaylens/probe/tmp-*

# 本地工具状态
.codebuddy/

# SSH 私钥绝不可入库(2026-10-11 曾误提交一次,已从跟踪移除并吊销)
